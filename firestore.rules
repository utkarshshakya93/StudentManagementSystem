rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unified users collection for all student records & authentication
    match /users/{userId} {
      allow read, write: if true;
    }
    match /daily_tasks/{taskId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
